%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!19 &1
Physics2DSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 8  # Updated to reflect potential advanced Unity version (2025)

  # Core Physics Settings - Foundation for simulation
  m_Gravity: {x: 0, y: -9.81}       # Default Earth gravity (m/s²), scene-overridable
  m_DefaultMaterial: {fileID: 0}    # No default physics material
  m_SimulationTimestep: 0.016667    # 60 Hz fixed timestep (1/60s) for smooth physics
  m_PhysicsUpdateRate: 60           # Explicit physics update rate (Hz)
  m_GravityScaleFactor: 1.0         # New: Global gravity multiplier

  # Solver Settings - Ultra-precise and scalable
  m_VelocityIterations: 20          # Maxed for ultra-precise velocity resolution
  m_PositionIterations: 10          # Enhanced for complex positional accuracy
  m_VelocityThreshold: 0.1          # Extremely low for hyper-responsive collisions
  m_MaxLinearCorrection: 0.4        # Robust overlap correction
  m_MaxAngularCorrection: 20        # High precision for rotational stability
  m_MaxTranslationSpeed: 500        # Increased for ultra-fast objects
  m_MaxRotationSpeed: 1800          # Quintupled for extreme rotational dynamics
  m_SolverConvergenceThreshold: 0.0001  # New: Convergence precision for solver

  # Stabilization and Sleep - Optimized for efficiency and realism
  m_BaumgarteScale: 0.4             # Very strong constraint enforcement
  m_BaumgarteTimeOfImpactScale: 0.95  # Near-perfect TOI resolution
  m_TimeToSleep: 0.15               # Very fast sleep for performance
  m_LinearSleepTolerance: 0.0005    # Ultra-tight sleep detection
  m_AngularSleepTolerance: 0.1      # Extremely precise angular sleep
  m_SleepMode: 1                    # 0=NeverSleep, 1=EnergyBased, 2=AlwaysSleep
  m_SleepEnergyThreshold: 0.005     # New: Energy threshold for sleep mode 1

  # Collision Settings - Cutting-edge for modern 2D games
  m_DefaultContactOffset: 0.0005    # Pixel-perfect collision precision
  m_QueriesHitTriggers: 1           # Enable trigger queries
  m_QueriesStartInColliders: 0      # Prevent queries starting inside colliders
  m_CallbacksOnDisable: 1           # Preserve callback behavior
  m_ReuseCollisionCallbacks: 1      # Optimize callback performance
  m_ContactCaching: 1               # Enable contact caching
  m_ContactPreSolving: 1            # Pre-solve collisions for better response
  m_ContactPostSolving: 1           # New: Post-solve for additional refinement

  # Job System Settings - Optimized for high-end multi-core CPUs
  m_JobOptions:
    serializedVersion: 5            # Advanced job system version
    useMultithreading: 1            # Enabled for parallel processing
    useConsistencySorting: 1        # Deterministic collision order
    m_InterpolationPosesPerJob: 250       # Increased for massive simulations
    m_NewContactsPerJob: 80               # Optimized for modern CPUs
    m_CollideContactsPerJob: 200          # High parallelism for collision
    m_ClearFlagsPerJob: 500               # Enhanced for efficiency
    m_ClearBodyForcesPerJob: 500          # Enhanced for efficiency
    m_SyncDiscreteFixturesPerJob: 120     # Optimized for discrete collision
    m_SyncContinuousFixturesPerJob: 120   # Optimized for continuous collision
    m_FindNearestContactsPerJob: 250      # Enhanced query performance
    m_UpdateTriggerContactsPerJob: 250    # Enhanced trigger performance
    m_IslandSolverCostThreshold: 300      # Increased for very large scenes
    m_IslandSolverBodyCostScale: 1        # Standard body cost
    m_IslandSolverContactCostScale: 25    # High priority for contacts
    m_IslandSolverJointCostScale: 25      # High priority for joints
    m_IslandSolverBodiesPerJob: 120       # Optimized for parallelism
    m_IslandSolverContactsPerJob: 120     # Optimized for parallelism
    m_DynamicBatchSize: 128               # Quadrupled for adaptive batching
    m_JobPriorityThreshold: 0.8           # Refined job scheduling priority
    m_ThreadAffinityMask: 0               # New: 0=Auto, bitmask for core pinning

  # Simulation Settings - Advanced and flexible control
  m_AutoSimulation: 1              # Automatic physics simulation
  m_AutoSyncTransforms: 1          # Transform consistency
  m_SimulationMode: 2              # 0=Fixed, 1=Update, 2=Script
  m_PhysicsPredictionSteps: 3      # Increased prediction steps (0-4)
  m_SimulationWarmupFrames: 5      # New: Frames to stabilize simulation on start

  # Debug Visualization - Comprehensive toolkit for developers
  m_AlwaysShowColliders: 1         # Always show colliders
  m_ShowColliderSleep: 1           # Visualize sleep states
  m_ShowColliderContacts: 1        # Show contact points
  m_ShowColliderAABB: 1            # Display AABB bounds
  m_ContactArrowScale: 0.4         # Even larger arrows for visibility
  m_ShowCollisionNormals: 1        # Visualize collision normals
  m_DebugLayerCollisions: 0        # Disabled by default for performance
  m_ShowPhysicsHeatmap: 0          # Disabled heatmap by default
  m_VisualizeConstraintForces: 1   # New: Show forces on constraints

  # Debug Colors - Maximum clarity and distinction
  m_ColliderAwakeColor: {r: 0.0, g: 1.0, b: 0.15, a: 0.95}      # Pure green for awake
  m_ColliderAsleepColor: {r: 0.15, g: 0.15, b: 0.15, a: 0.7}    # Dark gray for asleep
  m_ColliderContactColor: {r: 1.0, g: 0.0, b: 1.0, a: 0.85}     # Pure magenta for contacts
  m_ColliderAABBColor: {r: 1.0, g: 1.0, b: 0.0, a: 0.55}        # Pure yellow for AABB
  m_CollisionNormalColor: {r: 0.0, g: 0.95, b: 1.0, a: 0.8}     # Vibrant cyan for normals
  m_PhysicsHeatmapColor: {r: 1.0, g: 0.0, b: 0.0, a: 0.65}      # Bright red for heatmap
  m_ConstraintForceColor: {r: 0.0, g: 0.5, b: 1.0, a: 0.75}     # New: Blue for constraint forces

  # Layer Collision Matrix - All layers collide (256 bits for 32 layers)
  m_LayerCollisionMatrix: ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

  # Advanced Features - Hypothetical Unity advancements for 2025
  m_ContactPrediction: 1             # Enable predictive contacts
  m_SimulationQuality: 3             # 0=Low, 1=Medium, 2=High, 3=Ultra
  m_ContactDebugLogging: 0           # Disabled for performance
  m_PhysicsBatching: 1               # Enable batching optimization
  m_AdaptiveTimestep: 1              # Adaptive timestep for frame consistency
  m_MaxSubSteps: 12                  # Increased for finer adaptive precision
  m_ConstraintRelaxation: 0.98       # Near-perfect constraint stability
  m_CollisionResponseMode: 1         # 0=Discrete, 1=Continuous for critical objects
  m_PhysicsMemoryBudget: 128         # Doubled memory budget (MB) for physics
  m_DynamicGravityZones: 1           # Enable variable gravity areas
  m_CollisionFilterOptimization: 1   # Optimize collision filtering
  m_PhysicsAIAugmentation: 1         # New: AI-assisted physics optimization
  m_SpatialPartitioningMode: 2       # New: 0=None, 1=Grid, 2=Octree for collision
  m_ContactResolutionPriority: 1     # New: Prioritize critical contact resolution
